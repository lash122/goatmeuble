# One canonical URL for the home page: /index.html folds into /.
/index.html  /  301

# Pretty product links. A product lives at /?p=<id>, but /p/<id> is nicer in an
# ad — serve the shopfront for it (200, not a redirect, so the path survives)
# and let openFromUrl() in js/store.js read the id back out of it.
/p/*         /  200

# Anything else falls through to 404.html, which Netlify and Cloudflare Pages
# both serve automatically for an unmatched path. No rule needed here — but
# adding a catch-all /* rule WOULD break it, so don't.

# Rescue rule for visitors whose browser still holds the pre-fix storefront
# script: it builds garbage product links like /boutique.htmlp/77/ from any
# page. Redirect every <page>.htmlp/<id>/ shape to the real product page.
/boutique.htmlp/*  /p/:splat   301
/index.htmlp/*     /p/:splat   301
/track.htmlp/*     /p/:splat   301
